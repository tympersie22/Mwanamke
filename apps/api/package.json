{
  "name": "@mwanamke/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_POSTGRES_TESTS=true vitest run src/postgres.integration.test.ts --testTimeout 15000",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@mwanamke/domain": "*",
    "@mwanamke/security": "*",
    "@prisma/client": "6.12.0",
    "fastify": "^5.6.0",
    "ioredis": "^5.11.1",
    "jose": "6.2.10",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "6.12.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  }
}

{
  "name": "mwanamke-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mwanamke/portal",
    "dev:api": "npm run dev -w @mwanamke/api",
    "build": "npm run build -w @mwanamke/portal && npm run build -w @mwanamke/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "expo": "57.0.25",
    "expo-constants": "57.0.19",
    "expo-router": "57.0.23",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "expo": "57.0.25",
    "expo-router": "57.0.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  }
}
